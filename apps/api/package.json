{
  "name": "@tileset/api",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "6.19.3",
    "@tileset/ai-gateway": "workspace:*",
    "@tileset/asset-core": "workspace:*",
    "@tileset/contracts": "workspace:*",
    "@tileset/image-adapter": "workspace:*",
    "@tileset/local-executor": "workspace:*",
    "@tileset/material-processing": "workspace:*",
    "@tileset/mz-compiler": "workspace:*",
    "@tileset/pack-assembly": "workspace:*",
    "@tileset/pack-export": "workspace:*",
    "@tileset/persistence": "workspace:*",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "helmet": "8.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "wavespeed": "0.3.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "22.19.0",
    "prisma": "6.19.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}

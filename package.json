{
  "name": "@tileset/prototype",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": "22.21.1",
    "pnpm": "10.20.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "preinstall": "node scripts/toolchain.mjs",
    "typecheck": "pnpm build:contracts && tsc --noEmit && tsc -p tsconfig.tests.json && pnpm -r --filter './apps/*' --filter './packages/*' typecheck",
    "build:prototype": "pnpm build:contracts && tsc",
    "build:contracts": "pnpm --filter @tileset/contracts build && pnpm --filter @tileset/ai-gateway build && pnpm --filter @tileset/asset-core build && pnpm --filter @tileset/material-processing build && pnpm --filter @tileset/image-adapter build && pnpm --filter @tileset/mz-compiler build && pnpm --filter @tileset/pack-assembly build && pnpm --filter @tileset/pack-export build && pnpm --filter @tileset/persistence build && pnpm --filter @tileset/local-executor build",
    "build": "node scripts/clean-build.mjs && pnpm build:prototype && pnpm --filter @tileset/api build && node dist/scripts/studio-resources.js && pnpm --filter @tileset/web build",
    "test": "pnpm build:prototype && vitest run",
    "test:e2e": "playwright test",
    "test:dev-privacy": "pnpm build:contracts && vitest run apps/web/tests/dev-privacy.test.ts",
    "test:integration": "pnpm build:contracts && vitest run --config vitest.integration.config.ts",
    "lint": "eslint src scripts tests apps packages *.ts *.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm check:boundaries && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build && pnpm verify:exports",
    "db:generate": "pnpm --filter @tileset/api db:generate",
    "db:migrate": "pnpm --filter @tileset/api db:migrate",
    "db:local": "node scripts/local-postgres.mjs",
    "dev": "pnpm build:prototype && pnpm --filter @tileset/api build && node dist/scripts/studio-resources.js && node scripts/run-local.mjs dev",
    "start": "node scripts/run-local.mjs production",
    "fixtures": "pnpm build:prototype && node dist/scripts/make-fixtures.js",
    "prototype": "pnpm build:prototype && node dist/scripts/build-prototype.js",
    "verify:mz": "pnpm build:prototype && node dist/scripts/verify-mz.js",
    "prepare:mz": "pnpm build:prototype && node dist/scripts/prepare-mz.js",
    "build:engineering": "pnpm build && node scripts/build-engineering.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify:exports": "node scripts/verify-exports.mjs",
    "test:step03": "pnpm build:contracts && vitest run packages/asset-core/tests packages/material-processing/tests packages/image-adapter/tests",
    "build:step03": "pnpm build && node scripts/build-engineering.mjs step03",
    "build:material-sample": "pnpm build:contracts && node scripts/build-material-sample.mjs",
    "test:step04": "pnpm build:contracts && vitest run packages/mz-compiler/tests",
    "build:step04": "pnpm build && node scripts/build-engineering.mjs step04",
    "build:mz-sample": "pnpm build:prototype && node scripts/build-mz-sample.mjs",
    "verify:step04": "node dist/scripts/verify-step04.js",
    "prepare:step04": "node dist/scripts/prepare-step04.js",
    "test:step05": "pnpm build:prototype && vitest run packages/pack-assembly/tests tests/pack-export.test.ts tests/publication-ownership.test.ts",
    "build:pack-sample": "pnpm build:prototype && node dist/scripts/build-pack-sample.js",
    "verify:step05": "node dist/scripts/verify-step05.js",
    "export:pack": "node dist/scripts/export-pack.js",
    "prepare:step05": "node dist/scripts/prepare-step05.js",
    "test:step06": "pnpm build:prototype && vitest run --config vitest.step06.config.ts",
    "build:step06": "pnpm build && node scripts/build-engineering.mjs step06",
    "backup:local": "node --env-file=.env dist/scripts/step06-maintenance.js backup",
    "restore:local": "node --env-file=.env dist/scripts/step06-maintenance.js restore",
    "tasks:mock": "node --env-file=.env dist/scripts/run-mock-executor.js",
    "build:step07": "pnpm build && node scripts/build-engineering.mjs step07",
    "test:step07": "pnpm build && vitest run --config vitest.step07.config.ts",
    "test:step08": "pnpm build && vitest run --config vitest.step08.config.ts",
    "test:step08:real": "node scripts/step08-real.mjs",
    "build:step08": "pnpm build && node scripts/build-engineering.mjs step08",
    "test:step09": "pnpm build && vitest run --config vitest.step09.config.ts",
    "build:step09": "pnpm build && node scripts/build-engineering.mjs step09",
    "prepare:step09": "node dist/scripts/prepare-step09.js",
    "report:step09": "node scripts/step09-report.mjs"
  },
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "22.19.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "prettier": "3.9.10",
    "@playwright/test": "1.64.0",
    "@tileset/asset-core": "workspace:*",
    "@tileset/material-processing": "workspace:*",
    "@tileset/image-adapter": "workspace:*",
    "@tileset/mz-compiler": "workspace:*",
    "@tileset/pack-assembly": "workspace:*",
    "@tileset/persistence": "workspace:*",
    "@tileset/local-executor": "workspace:*",
    "@tileset/ai-gateway": "workspace:*",
    "@tileset/pack-export": "workspace:*"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "@nestjs/core"
    ],
    "overrides": {
      "deepmerge-ts": "8.0.2"
    }
  }
}

{
  "gitObjectEnvOverrides": {
    "GIT_OBJECT_DIRECTORY": false,
    "GIT_ALTERNATE_OBJECT_DIRECTORIES": false,
    "GIT_DIR": false,
    "GIT_WORK_TREE": false,
    "GIT_COMMON_DIR": false
  },
  "fullCommonDir": ".git",
  "repositories": [
    {
      "repository": "git-origin",
      "objectRoot": "git-origin/objects",
      "exists": true,
      "alternatesExists": false,
      "looseAndPackFileCount": 3
    },
    {
      "repository": "full",
      "objectRoot": "full/.git/objects",
      "exists": true,
      "alternatesExists": false,
      "looseAndPackFileCount": 3
    },
    {
      "repository": "shallow",
      "objectRoot": "shallow/.git/objects",
      "exists": true,
      "alternatesExists": false,
      "looseAndPackFileCount": 3
    }
  ],
  "fileTransportActualFetch": true,
  "sharedObjectAlternates": false,
  "globalConfigMutated": false
}

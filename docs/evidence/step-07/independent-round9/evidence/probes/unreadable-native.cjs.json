  "documentarySource": "const fs=require('node:fs'),path=require('node:path');const f=path.resolve('.env');const out={node:process.version,uid:process.getuid(),exists:fs.existsSync(f),mode:(fs.statSync(f).mode&511).toString(8)};try{fs.readFileSync(f);out.fsRead='accepted'}catch(e){out.fsRead={code:e.code}}try{process.loadEnvFile(f);out.native='accepted'}catch(e){out.native={code:e.code}}console.log(JSON.stringify(out));"
